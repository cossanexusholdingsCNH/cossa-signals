# Cossa Signals — environment variable template
# Copy this file to ".env" in the same folder, then fill in real values.
# NEVER commit the real ".env" file — it is already excluded in .gitignore.

# --- OANDA (forex data + demo trading) ---
# Free demo account: https://www.oanda.com/demo-account/
OANDA_API_KEY=
OANDA_ACCOUNT_ID=
OANDA_ENV=practice
# OANDA_ENV options: "practice" (demo, free, use this until fully validated) or "live"

# --- Deriv (synthetic indices: Volatility, Boom, Crash) ---
# Register a free app_id (required, no cost): https://api.deriv.com/dashboard/
# Historical market data (ticks_history) does NOT require a token.
# LIVE data (ticks subscribe, active_symbols) DOES require an authorized
# connection, even for read-only use — confirmed 2026-08-10 after R_75
# itself failed live tick subscription with no token set.
#
# This is safe to set now, including before paper trading / copy-trade:
# generate the token at https://app.deriv.com/account/api-token with
# ONLY the "Read" scope checked — leave Trade, Payments, and Admin
# unchecked. A Read-scoped token can authorize a connection and stream
# live prices; it cannot place an order or move money, no matter what
# the code does. Do NOT check Trade/Payments/Admin until the copy-trade
# phase — that's the actual point where a mistake could cost money.
DERIV_APP_ID=
DERIV_API_TOKEN=

# --- Alpha Vantage (fundamentals / backup data source) ---
# Free key: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_KEY=

# --- Telegram bot (signal delivery) ---
# Create via @BotFather on Telegram — free, takes 2 minutes
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Supabase (storage for signals, backtest results, users) ---
SUPABASE_URL=
SUPABASE_KEY=
